# LOCAL DEVELOPMENT API CONFIGURATION
# Copy this file to .env.local. The hosted API works without running a local backend.
# Do NOT commit the .env file to Git

# For local backend development, use http://localhost:5000/api instead.
REACT_APP_API_URL=https://rubavu-today-backend.onrender.com/api

# NOTE: 
# - The hosted backend may take a short time to wake up on the first request
# - For a local backend, start it from the backend folder and use the URL above
# - In production (Vercel/Netlify), API calls are proxied via vercel.json and netlify.toml
#   to https://rubavu-today-backend.onrender.com/api
